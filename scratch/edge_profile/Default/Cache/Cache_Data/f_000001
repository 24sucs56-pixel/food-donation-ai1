<!-- Action Confirmation Modal -->
<div id="confirmationModal" class="modal" style="display:none; position:fixed; z-index:1000; left:0; top:0; width:100%; height:100%; overflow:auto; background-color:rgba(0,0,0,0.6); align-items:center; justify-content:center;">
    <div class="modal-content" style="background-color:#fff; margin:auto; padding:25px; border:1px solid #e2e8f0; width:85%; max-width:480px; border-radius:16px; position:relative; text-align:center; box-shadow: 0 15px 35px rgba(0,0,0,0.25); animation: zoomIn 0.3s;">
        <h2 style="color:#0f172a; margin-bottom:12px; font-weight: 700; font-size: 20px;" id="confirmModalTitle">Confirm Action</h2>
        <p style="color:#64748b; font-size:14px; margin-bottom:20px;" id="confirmModalMessage">Are you sure you want to perform this action?</p>
        <div style="display:flex; justify-content:center; gap:15px;">
            <button class="btn-action" style="background-color:#e2e8f0; color:#334155; padding: 10px 20px; font-size: 14px;" id="confirmModalCancelBtn">Cancel</button>
            <button class="btn-action btn-approve" style="padding: 10px 20px; font-size: 14px;" id="confirmModalExecuteBtn">Proceed</button>
        </div>
    </div>
</div>


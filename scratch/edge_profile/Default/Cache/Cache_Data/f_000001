    <div class="modal-content" style="background-color:#fff; margin:auto; padding:25px; border:1px solid #e2e8f0; width:90%; max-width:600px; border-radius:16px; position:relative; text-align:left; box-shadow: 0 15px 35px rgba(0,0,0,0.25); animation: zoomIn 0.3s;">

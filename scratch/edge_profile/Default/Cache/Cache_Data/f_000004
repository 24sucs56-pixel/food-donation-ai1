/*====================================================
                SMART FOOD DONATION AI DASHBOARD
====================================================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Poppins",sans-serif;
}

:root{

    --primary:#16a34a;
    --primary-dark:#15803d;
    --secondary:#22c55e;

    --bg:#f5fff7;

    --card:#ffffff;

    --text:#111827;

    --text-light:#64748b;

    --border:#e5e7eb;

    --shadow:0 10px 30px rgba(0,0,0,.08);

}

body{

    background:var(--bg);

    color:var(--text);

}

.dashboard{

    display:flex;

    min-height:100vh;

}

@media (min-width: 769px) {
    .main-content{

        margin-left:270px;

        width:calc(100% - 270px);

        padding:30px;

    }

    /*====================================================
                        SIDEBAR
    ====================================================*/

    .sidebar{

        width:270px;

        position:fixed;

        left:0;

        top:0;

        height:100vh;

        background:linear-gradient(180deg,#16a34a,#22c55e);

        padding:25px;

        display:flex;

        flex-direction:column;

    }
}

.logo{

    display:flex;

    align-items:center;

    gap:15px;

    margin-bottom:40px;

}

.logo img{

    width:60px;

}

.logo-text h2{

    color:white;

    font-size:28px;

    font-weight:700;

}

.logo-text p{

    color:#dcfce7;

    font-size:13px;

    margin-top:5px;

}

.menu{

    list-style:none;

}

.menu li{

    display:flex;

    align-items:center;

    gap:15px;

    padding:16px;

    margin-bottom:12px;

    border-radius:15px;

    color:white;

    cursor:pointer;

    transition:.3s;

}

.menu li:hover{

    background:rgba(255,255,255,.15);

}

.menu li.active{

    background:white;

    color:#16a34a;

    font-weight:600;

}

.menu i{

    font-size:20px;

}

.sidebar-user{

    margin-top:auto;

    display:flex;

    align-items:center;

    gap:15px;

    background:rgba(255,255,255,.12);

    border-radius:15px;

    padding:15px;

}

.sidebar-user img{

    width:50px;

    height:50px;

    border-radius:50%;

}

.sidebar-user h4{

    color:white;

}

.sidebar-user p{

    color:#dcfce7;

    font-size:13px;

}
/*====================================================
                    TOPBAR
====================================================*/

.topbar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    background:var(--card);

    padding:18px 28px;

    border-radius:20px;

    box-shadow:var(--shadow);

    margin-bottom:30px;

}

/* Search Box */

.search-box{

    display:flex;

    align-items:center;

    gap:12px;

    width:420px;

    background:#f8fafc;

    padding:14px 18px;

    border-radius:15px;

}

.search-box i{

    color:var(--primary);

    font-size:18px;

}

.search-box input{

    width:100%;

    border:none;

    outline:none;

    background:none;

    font-size:15px;

}

/* Right Side */

.topbar-right{

    display:flex;

    align-items:center;

    gap:18px;

}
/*====================================================
                    WELCOME
====================================================*/

.welcome{

    margin-bottom:35px;

}

.welcome h1{

    font-size:48px;

    font-weight:700;

    color:var(--text);

    margin-bottom:12px;

}

.welcome p{

    font-size:18px;

    color:var(--text-light);

    line-height:1.7;

    max-width:700px;

}
/*====================================================
                DASHBOARD CARDS
====================================================*/

.dashboard-cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

    gap:25px;

    margin-bottom:40px;

}

.card{

    background:var(--card);

    border-radius:20px;

    padding:25px;

    display:flex;

    align-items:center;

    gap:20px;

    box-shadow:var(--shadow);

    transition:.3s;

    border-top:5px solid var(--primary);

}

.card:hover{

    transform:translateY(-6px);

    box-shadow:0 18px 35px rgba(22,163,74,.15);

}
.card-icon{

    width:70px;

    height:70px;

    border-radius:18px;

    background:linear-gradient(135deg,
        var(--primary),
        var(--secondary));

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

    font-size:30px;

    flex-shrink:0;

}
.card-info{

    flex:1;

}

.card-info h2{

    font-size:38px;

    font-weight:700;

    color:var(--text);

    margin-bottom:8px;

}

.card-info p{

    color:var(--text-light);

    font-size:16px;

}
/*====================================================
                DONATION ANALYTICS
====================================================*/

.analytics{

    display:grid;

    grid-template-columns:2fr 1fr;

    gap:25px;

    margin-top:35px;

}

.analytics-left{

    background:var(--card);

    border-radius:20px;

    padding:25px;

    box-shadow:var(--shadow);

}

.section-title h2{

    font-size:24px;

    color:var(--text);

}

.section-title p{

    color:var(--text-light);

    margin-top:5px;

    margin-bottom:20px;

}

.chart-container{

    width:100%;

    height:350px;

}

.analytics-right{

    display:flex;

    flex-direction:column;

    gap:20px;

}

.progress-card{

    background:var(--card);

    padding:20px;

    border-radius:20px;

    box-shadow:var(--shadow);

}

.progress-card h3{

    margin-bottom:15px;

    font-size:18px;

}

.progress-bar{

    width:100%;

    height:10px;

    background:#e5e7eb;

    border-radius:20px;

    overflow:hidden;

}

.progress{

    height:100%;

    border-radius:20px;

}

.progress1{

    width:95%;

    background:#22c55e;

}

.progress2{

    width:91%;

    background:#3b82f6;

}

.progress3{

    width:96%;

    background:#f59e0b;

}

.progress-card span{

    display:block;

    margin-top:12px;

    font-weight:600;

    color:var(--text-light);

}
/*====================================================
                RECENT DONATIONS
====================================================*/

.recent-donations{

    margin-top:35px;

    background:var(--card);

    padding:25px;

    border-radius:20px;

    box-shadow:var(--shadow);

}

.table-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;

}

.table-header h2{

    font-size:24px;

    color:var(--text);

}

.view-all-btn{

    border:none;

    background:var(--primary);

    color:#fff;

    padding:10px 18px;

    border-radius:10px;

    cursor:pointer;

    font-weight:600;

    transition:.3s;

}

.view-all-btn:hover{

    background:var(--primary-dark);

}

.table-container{

    overflow-x:auto;

}

table{

    width:100%;

    border-collapse:collapse;

}

thead{

    background:#f8fafc;

}

thead th{

    padding:18px;

    text-align:left;

    color:var(--text);

    font-size:15px;

    border-bottom:2px solid var(--border);

}

tbody td{

    padding:18px;

    border-bottom:1px solid var(--border);

    color:var(--text-light);

}

tbody tr{

    transition:.3s;

}

tbody tr:hover{


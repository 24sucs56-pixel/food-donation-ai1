                PROFILE DROPDOWN
====================================================*/

.profile-container{

    position:relative;

}

.profile-menu{

    position:absolute;

    top:75px;

    right:0;

    width:240px;

    background:#ffffff;

    border-radius:18px;

    box-shadow:0 15px 35px rgba(0,0,0,.12);

    overflow:hidden;

    display:none;

    z-index:1000;

    animation:fadeDown .25s ease;

}
.profile-menu.show,
.profile-menu.active{

    display:block !important;

}
.profile-menu a{

    display:flex;

    align-items:center;

    gap:15px;

    padding:16px 20px;

    text-decoration:none;

    color:#374151;

    font-size:15px;

    transition:.3s;

}

.profile-menu a:hover{

    background:#f3f4f6;

    color:#16a34a;

}

.profile-menu i{

    width:20px;

    text-align:center;

}
@keyframes fadeDown{

    from{

        opacity:0;

        transform:translateY(-12px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

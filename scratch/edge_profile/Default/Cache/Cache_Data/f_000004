.notification-container{

    position:relative;

}

.notification-menu{

    position:absolute;

    top:65px;

    right:0;

    width:360px;

    background:white;

    border-radius:18px;

    box-shadow:0 18px 45px rgba(0,0,0,.15);

    overflow:hidden;

    display:none;

    z-index:999;

}

.notification-menu.show{

    display:block;

}

.notification-title{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:18px 22px;

    border-bottom:1px solid var(--border);

}

.notification-title span{

    background:var(--primary);

    color:white;

    padding:4px 12px;

    border-radius:30px;

    font-size:12px;

}

.notification-card{

    display:flex;

    gap:15px;

    padding:18px 22px;

    cursor:pointer;

    transition:.3s;

}

.notification-card:hover{

    background:#f5fff7;

}

.notify-icon{

    font-size:26px;

}

.notify-text{

    flex:1;

}

.notify-text h4{

    font-size:15px;

    margin-bottom:4px;

}

.notify-text p{

    font-size:14px;

    color:var(--text-light);

}

.notify-text small{

    color:#999;

}

.view-all{

    width:100%;

    padding:15px;

    border:none;

    background:var(--primary);

    color:white;

    cursor:pointer;

    font-size:15px;

}

.view-all:hover{

    background:var(--primary-dark);

}
.current-date{

    margin-top:12px;

    font-size:15px;

    color:#64748b;

    font-weight:500;

}
/*====================================================
                LIVE CLOCK
====================================================*/

.live-clock{

    margin-top:8px;

    font-size:16px;

    font-weight:600;

    color:var(--primary);

}
/*====================================================
                DARK MODE
====================================================*/

body.dark-mode{

    background:#0f172a;

    color:#f8fafc;

}

body.dark-mode .topbar,
body.dark-mode .card,
body.dark-mode .analytics,
body.dark-mode .recent-donations,
body.dark-mode .ai-section,
body.dark-mode .profile-menu,
body.dark-mode .notification-menu{

    background:#1e293b;

    color:#ffffff;

}

body.dark-mode .search-box{

    background:#334155;

}

body.dark-mode .search-box input{

    color:#ffffff;

}

body.dark-mode .search-box input::placeholder{

    color:#cbd5e1;

}

body.dark-mode .card-info h2,
body.dark-mode .welcome h1,
body.dark-mode .section-title h2{

    color:#ffffff;

}

body.dark-mode p,
body.dark-mode small,
body.dark-mode td,
body.dark-mode th{

    color:#cbd5e1;

}

body.dark-mode table{

    background:#1e293b;

}

body.dark-mode .progress-card{

    background:#334155;

}

body.dark-mode .icon-button{

    background:#334155;

    color:#ffffff;

}

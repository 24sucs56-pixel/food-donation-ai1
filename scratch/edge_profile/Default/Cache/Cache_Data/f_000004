.notification-container{

    position:relative;

}

.notification-menu{

    position:absolute;

    top:70px;

    right:0;

    width:360px;

    background:#fff;

    border-radius:20px;

    box-shadow:0 20px 40px rgba(0,0,0,.15);

    display:none;

    overflow:hidden;

    z-index:999;

}

.notification-menu.show{

    display:block;

}

.notification-header{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:20px;

    border-bottom:1px solid #eee;

}


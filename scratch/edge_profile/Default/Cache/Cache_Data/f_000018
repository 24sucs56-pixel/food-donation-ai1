    .kpi-info p {
        font-size: 9.5px !important;
    }

    #volunteerSection header > div:last-child {
        gap: 6px !important;
    }

    .task-status-box,
    .rating-status-box {
        padding: 10px 8px !important;
    }

    .task-status-box span:nth-of-type(1),
    .rating-status-box span:nth-of-type(1) {
        font-size: 20px !important;
    }
}

/* ==========================================
   SUB-BREAKPOINT: Ultra-Compact Screens (<= 340px, e.g. 320px)
   Convert cards into 1-column layout
   ========================================== */
@media (max-width: 340px) {
    .main-content {
        padding: 8px 6px 35px 6px !important;
    }

    .dashboard-cards,
    .cards {
        grid-template-columns: 1fr !important;
        gap: 10px !important;
    }

    .dashboard-cards .card,
    .cards .card {
        padding: 12px 12px !important;
        gap: 12px !important;
    }

    .card-icon {
        width: 44px !important;
        height: 44px !important;
        min-width: 44px !important;
        font-size: 20px !important;
    }

    .card-info h2,
    .card-info .counter {
        font-size: 22px !important;
    }

    .card-info p {
        font-size: 12px !important;
    }

    #rewardsSection > div > div:nth-child(2) {
        grid-template-columns: 1fr !important;
        gap: 8px !important;
    }

    #rewardsSection > div > div:nth-child(2) > div {
        padding: 10px 10px !important;
    }

    #rewardsSection > div > div:nth-child(2) > div span:first-child {
        font-size: 10.5px !important;
    }

    #rewardsSection > div > div:nth-child(2) > div span:last-child {
        font-size: 16px !important;
    }

    .chart-container {
        height: 190px !important;
    }

    /* Donate Form in <= 340px (320px screens) */
    .container {
        padding: 10px 8px !important;
    }

    .location-fields {
        grid-template-columns: 1fr !important;
        gap: 6px !important;
    }

    .time-box {
        min-width: 110px !important;
    }

    .period-select {
        flex: 0 0 70px !important;
        width: 70px !important;
        padding: 0 4px !important;
        font-size: 12.5px !important;
    }

    .submit-btn,
    button[type="submit"].submit-btn {
        font-size: 15px !important;
        height: 48px !important;
        min-height: 48px !important;
    }

    /* Modules 1-6 in <= 340px (320px screens) */
    .card-stats-grid {
        grid-template-columns: 1fr !important;
        gap: 6px !important;
    }

    .reports-kpi-grid {
        grid-template-columns: 1fr !important;
        gap: 6px !important;
    }

    #volunteerSection header > div:last-child {
        grid-template-columns: 1fr !important;
        gap: 6px !important;
    }

    #chatInput {
        font-size: 13px !important;
    }
    /* ==========================================
       ADMIN MODULE MOBILE RESPONSIVE STYLING
       Targeted for 360px, 390px, 412px (Pixel 7), 430px, 768px
       ========================================== */
    .admin-summary-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 10px !important;
    }

    .admin-summary-grid .card {
        padding: 14px 10px !important;
        border-radius: 14px !important;
    }

    .admin-summary-grid .card h2 {
        font-size: 22px !important;
        margin-bottom: 4px !important;
    }

    .admin-summary-grid .card p {
        font-size: 11px !important;
    }

    .filter-controls-card {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
        padding: 14px !important;
    }

    .quick-action-buttons {
        flex-direction: column !important;
        gap: 8px !important;
        width: 100% !important;
    }

    .btn-quick-action {
        width: 100% !important;
        justify-content: center !important;
        padding: 11px !important;
        font-size: 13px !important;
    }

    .overview-grid {
        grid-template-columns: 1fr !important;
        gap: 12px !important;
    }

    .dashboard-dual-grid {
        grid-template-columns: 1fr !important;
        gap: 16px !important;
    }

    .filter-tab-bar {
        display: flex !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        padding-bottom: 6px !important;
        -webkit-overflow-scrolling: touch !important;
    }

    .filter-tab {
        flex-shrink: 0 !important;
        padding: 8px 14px !important;
        font-size: 12.5px !important;
    }

    .table-container {
        width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
    }

    .responsive-user-table th,
    .responsive-user-table td {
        padding: 12px 10px !important;
        font-size: 12.5px !important;
        white-space: nowrap !important;
    }
}

/* ==========================================
   DESKTOP PRESERVATION (>= 769px)
   ========================================== */
@media (min-width: 769px) {
    html,
    body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        height: 100% !important;
        overflow: hidden !important;
        background: #f8fffb;
    }

    .dashboard {
        display: flex !important;
        width: 100% !important;
        height: 100% !important;
        overflow: hidden !important;
    }

    .main-content {
        margin-left: 270px !important;
        width: calc(100% - 270px) !important;
        height: 100% !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
        display: block !important;
    }

    .mobile-menu-btn,
    .mobile-sidebar-close,
    .sidebar-overlay,
    .mobile-nav-toggle,
    .landing-mobile-drawer,
    .landing-drawer-overlay {
        display: none !important;
    }

    .topbar-fact {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        color: #15803d !important;
        font-weight: 550 !important;
        font-size: 14.5px !important;
        max-width: 60% !important;
        line-height: 1.4 !important;
        background: rgba(22, 163, 74, 0.06) !important;
        padding: 10px 18px !important;
        border-radius: 12px !important;
        border: 1px solid rgba(22, 163, 74, 0.15) !important;
    }

    .topbar-fact i {
        color: #eab308 !important;
        font-size: 17px !important;
        animation: pulse 2s infinite !important;
    }
}

/* =========================================
   COMPACT TIME INPUT
========================================= */

.time-input-wrapper {
    width: 100%;
    height: 50px;

    display: flex;
    align-items: center;

    border: 2px solid #c9f3dc;
    border-radius: 12px;

    background: #ffffff;

    padding: 0 14px;
    box-sizing: border-box;

    gap: 4px;
}


/* Time Icon */

.time-input-wrapper .time-icon {
    color: #16a34a;
    font-size: 17px;

    margin-right: 8px;

    flex-shrink: 0;
}


/* Hour / Minute / AM-PM */

.time-input-wrapper select {
    border: none;
    outline: none;

    background: transparent;

    height: 40px;

    font-size: 15px;
    font-weight: 500;

    color: #111827;

    cursor: pointer;

    padding: 0 4px;
}


/* Hour */

.time-input-wrapper select[id$="Hour"] {
    width: 58px;
}


/* Minute */

.time-input-wrapper select[id$="Minute"] {
    width: 48px;
}


/* AM / PM */

.time-input-wrapper select[id$="Period"] {
    width: 58px;
    font-weight: 600;
}


/* Colon */

.time-colon {
    font-size: 17px;
    font-weight: bold;
    color: #374151;

    margin: 0 1px;
}


/* Focus */

.time-input-wrapper:focus-within {
    border-color: #16a34a;

    box-shadow:
        0 0 0 3px rgba(22, 163, 74, 0.10);
}
/* =========================================
   DONATION FORM
========================================= */

.donation-form,
form {
    width: 100%;

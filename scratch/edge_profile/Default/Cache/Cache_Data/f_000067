/*==========================================================
                SMART FOOD DONATION AI DONATE PAGE
==========================================================*/

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

:root{

    --primary:#16a34a;
    --secondary:#22c55e;
    --white:#ffffff;
    --gray:#64748b;
    --dark:#0f172a;

}

body{

    background:#ecfdf5;

}
.container{

    width:100%;

    background:white;

    padding:35px;

    border-radius:20px;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.container header{

    margin-bottom:35px;

}
.container header h1{

    color:#16a34a;

    font-size:34px;

}

.container header p{

    color:#64748b;

    margin-top:10px;

}
/*==========================================================
                INPUTS
==========================================================*/

.input-group{

    margin-bottom:22px;

}

.input-group label{

    display:block;

    margin-bottom:8px;

    font-weight:600;

    color:#0f172a;

}

.input-group input,
.input-group select,
.input-group textarea{

    width:100%;

    padding:14px;

    border:2px solid #d1fae5;

    border-radius:12px;

    outline:none;

    font-size:15px;

    transition:.3s;

}

.input-group input:focus,
.input-group select:focus,
.input-group textarea:focus{

    border-color:#16a34a;

    box-shadow:0 0 12px rgba(22,163,74,.15);

}

textarea{

    resize:none;

}
/*==========================================================
                IMAGE
==========================================================*/

#previewImage{

    width:100%;

    height:300px;

    margin-top:20px;

    border-radius:15px;

    object-fit:cover;

    display:none;

    border:2px dashed #22c55e;

}

/*==========================================================
                BUTTON
==========================================================*/

.submit-btn{

    width:100%;

    height:55px;

    border:none;

    border-radius:12px;

    background:linear-gradient(135deg,#16a34a,#22c55e);

    color:white;

    font-size:18px;

    cursor:pointer;

    transition:.3s;

}

.submit-btn:hover{

    transform:translateY(-3px);

    box-shadow:0 15px 30px rgba(22,163,74,.25);

}
/*==========================================================
                RESPONSIVE
==========================================================*/

@media(max-width:768px){

.container{

    padding:25px;

}

header h1{

    font-size:30px;

}

}
/* =========================================
   DONATE PAGE - ALIGNMENT FIX
   ========================================= */
/* ==========================================
   AI FOOD SAFETY ANALYSIS
========================================== */

.ai-analysis {
    width: 100%;
    margin-top: 30px;
    box-sizing: border-box;
}

.ai-analysis h2 {
    margin: 0 0 20px 0;
    font-size: 22px;
}

/* Three cards in one row */
.analysis-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
}

/* Individual AI cards */
.analysis-card {
    min-width: 0;
    min-height: 130px;
    padding: 20px;
    box-sizing: border-box;
    border-radius: 15px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    overflow: hidden;
}

.analysis-card h3 {
    margin: 0 0 12px 0;
    font-size: 15px;
}

.analysis-card h1 {
    margin: 0;
    font-size: 28px;
    word-break: break-word;
}

.analysis-card p {
    margin: 0;
    line-height: 1.5;
    word-break: break-word;
}

/* Responsive */
@media (max-width: 900px) {

    .analysis-grid {
        grid-template-columns: 1fr;
    }

}


.coordinates{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:15px;

    margin-top:20px;

}

.coordinates input{

    padding:15px;

    border:2px solid #d1fae5;

    border-radius:12px;

    background:#f8fafc;

}
/*=========================================
    DONATE FORM GRID
=========================================*/

.form-grid{

    display:grid;

    grid-template-columns:repeat(2,1fr);

    gap:25px;

}

@media(max-width:900px){

    .form-grid{

        grid-template-columns:1fr;

    }

}
/*=========================================
    INPUT ICONS
=========================================*/

.input-icon{

    position:relative;

}

.input-icon i{

    position:absolute;

    left:18px;

    top:50%;

    transform:translateY(-50%);

    color:#16a34a;

    font-size:18px;

}

.input-icon input,
.input-icon select{

    padding-left:50px;

}
.input-icon input,
.input-icon select{

    height:56px;

    font-size:15px;

}

.input-icon:hover{

    transform:translateY(-2px);

    transition:.3s;

}
/* ==========================================
   CURRENT LOCATION BUTTON
   ========================================== */

.location-btn {

    width: 100%;
    margin-top: 15px;
    padding: 14px;

    border: none;
    border-radius: 12px;

    background: #16a34a;
    color: white;

    font-size: 16px;
    font-weight: 600;

    cursor: pointer;

    transition: 0.3s;
}

.location-btn:hover {

    background: #15803d;
    transform: translateY(-2px);

}

.location-btn i {

    margin-right: 8px;

}
/* ==========================================
   TIME INPUT
========================================== */
.time-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
}

.time-wrapper > i {
    width: 20px;
    flex-shrink: 0;
    color: #16a34a;
    text-align: center;
}

.simple-time {
    display: flex;
    align-items: center;
    width: 150px;
    height: 42px;
    border: 2px solid #d1fae5;
    border-radius: 10px;
    background: #fff;
    padding: 0 8px;
}

.simple-time:focus-within {
    border-color: #16a34a;
}

.simple-time input[type="time"] {
    width: 85px;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    color: #0f172a;
    padding: 0;
}

.simple-time select {
    width: 55px;
    border: none;
    outline: none;
    background: transparent;
    font-size: 14px;
    font-weight: 600;
    color: #0f172a;
    cursor: pointer;
}
/* =========================================
   DATE & TIME
========================================= */

.datetime-box {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
}

.date-box,
.time-box {
    display: flex;
    align-items: center;
    height: 48px;
    border: 2px solid #d1fae5;
    border-radius: 12px;
    background: #ffffff;
    padding: 0 12px;
}

.date-box {
    flex: 1.2;
}

.time-box {
    flex: 1;
}

.date-box i,
.time-box i {
    color: #16a34a;
    margin-right: 8px;
    flex-shrink: 0;
}

.date-box input,
.time-box input {
    border: none;
    outline: none;
    background: transparent;
    width: 100%;
    font-size: 14px;
    font-family: inherit;
}

/* AM / PM */

.period-select {
    height: 48px;
    width: 75px;
    border: 2px solid #d1fae5;
    border-radius: 12px;
    background: white;
    padding: 0 8px;
    font-size: 14px;
    cursor: pointer;
    outline: none;
}

.period-select:focus,
.date-box:focus-within,
.time-box:focus-within {
    border-color: #16a34a;
}
/* =========================================
   DATE & TIME ROW
========================================= */

.date-time-row {
    display: grid;
    grid-template-columns: 1fr 150px 120px;
    gap: 10px;
    width: 100%;
}

.date-time-row input,
.date-time-row select {
    width: 100%;
    box-sizing: border-box;
}
